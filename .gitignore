# Generated output — large runtime files, manage locally
# Timestamped run folders (audio, visuals, video)
output/*/audio/
output/*/visuals/
output/*/*.mp4
output/*/*.tmp_audio.m4a

# Legacy flat output paths
output/video_*.mp4
output/audio/
output/visuals/

# Keep these (small, useful for reruns)
!output/.gitkeep
!output/*/script.json
!output/*/thumbnail.jpg

# Python cache
__pycache__/
*.pyc
*.pyo

# Credentials (NEVER commit)
config/youtube_token.json
client_secrets.json
config/client_secrets.json
.env

# Logs
logs/
